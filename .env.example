# Backend environment configuration
# Copy this file to .env and configure for your environment

# Database
DATABASE_URL=sqlite:///./data/efl_analysis.db
# For PostgreSQL: postgresql://user:password@localhost:5432/efl_analysis

# ASR Provider: whisper, faster-whisper, whisperx, crisperwhisper
ASR_PROVIDER=whisper
ASR_MODEL=base
ASR_LANGUAGE=en
WHISPER_COMPUTE_TYPE=float32

# Diarization Provider: pyannote (Phase 2)
DIARIZATION_PROVIDER=pyannote
DIARIZATION_MODEL=pyannote/speaker-diarization-3.1

# LLM Provider: ollama, openai (disabled by default)
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:8b
LLM_BASE_URL=http://localhost:11434

# GPU Settings
GPU_ENABLED=false
CUDA_DEVICE=0

# Storage Paths
DATA_ROOT=./data
AUDIO_STORAGE_PATH=./data/audio
PROCESSED_STORAGE_PATH=./data/processed
VOICEPRINTS_STORAGE_PATH=./data/voiceprints
ARTIFACTS_STORAGE_PATH=./data/artifacts
REPORTS_STORAGE_PATH=./data/reports

# Processing Settings
MAX_AUDIO_DURATION_HOURS=2
VAD_MIN_SPEECH_DURATION_MS=250
SILENCE_TRIMMING_ENABLED=false
LOUDNESS_NORMALIZATION_TARGET=-16

# Identity Matching Thresholds (Phase 2)
VOICEPRINT_SIMILARITY_THRESHOLD=0.75
VOICEPRINT_ASSIGN_THRESHOLD=0.85
ONE_TO_ONE_MATCHING_ENABLED=true

# Disfluency Detection
DISFLUENCY_CONFIDENCE_THRESHOLD=0.6
REVIEW_REQUIRED_FOR_CEFR=true

# Privacy & Retention
DEFAULT_RETENTION_DAYS=365
CONSENT_REQUIRED_FOR_VOICEPRINT=true
CLOUD_FEATURES_ENABLED=false

# API Keys (only if using cloud providers)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
